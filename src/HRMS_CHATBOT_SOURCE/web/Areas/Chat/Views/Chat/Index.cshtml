@{
    ViewData["Title"] = "HRMS Chat";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/chat.css" />
</head>
<body class="wa-body">
    <div class="wa-app" id="waApp">
        <!-- Far-left icon rail (visual, like WhatsApp Web) -->
        <nav class="wa-rail">
            <div class="wa-rail-top">
                <button class="wa-rail-btn active" title="Chats" type="button">
                    <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
                </button>
                <button class="wa-rail-btn" title="Calls" type="button">
                    <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                </button>
                <button class="wa-rail-btn" title="Status" type="button">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="12 5"/><circle cx="12" cy="12" r="4"/></svg>
                </button>
                <button class="wa-rail-btn" title="Communities" type="button">
                    <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                </button>
            </div>
            <div class="wa-rail-bottom">
                <button class="wa-rail-btn" title="Settings" type="button">
                    <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                </button>
                <button class="wa-rail-btn wa-rail-avatar" title="Profile" type="button">
                    <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                </button>
            </div>
        </nav>

        <!-- Sidebar -->
        <aside class="wa-sidebar" id="waSidebar">
            <div class="wa-sidebar-top">
                <div class="wa-sidebar-header">
                    <h1 class="wa-wordmark">HRMS Chat</h1>
                    <div class="wa-sidebar-actions">
                        <button id="waRefreshBtn" class="wa-icon-btn" title="Refresh mobile numbers" type="button">
                            <svg viewBox="0 0 24 24"><path d="M17.65 6.35A7.95 7.95 0 0 0 12 4a8 8 0 1 0 7.75 10h-2.08A6 6 0 1 1 12 6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35Z"/></svg>
                        </button>
                        <button class="wa-icon-btn" title="Menu" type="button">
                            <svg viewBox="0 0 24 24"><path d="M12 8a2 2 0 1 0-.001-4.001A2 2 0 0 0 12 8Zm0 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 12 10Zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 12 16Z"/></svg>
                        </button>
                    </div>
                </div>

                <div class="wa-mobile-row">
                    <select id="waMobileSelect" class="wa-select" disabled>
                        <option value="">Loading mobile numbers…</option>
                    </select>
                    <button id="waStartChatBtn" class="wa-start-btn" type="button" hidden>Start Chat</button>
                </div>

                <div class="wa-search">
                    <svg viewBox="0 0 24 24" class="wa-search-icon"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14Z"/></svg>
                    <input type="text" id="waSearchInput" placeholder="Search or start a new chat" />
                </div>

                <div class="wa-filters">
                    <button class="wa-chip active" type="button">All</button>
                    <button class="wa-chip" type="button">Unread</button>
                    <button class="wa-chip wa-chip-add" type="button">+</button>
                </div>
            </div>

            <div class="wa-list" id="waList">
                <div class="wa-empty-state" id="waSidebarEmpty">
                    <p>Select a mobile number above and click <strong>Start Chat</strong> to begin.</p>
                </div>
            </div>
        </aside>

        <!-- Chat panel -->
        <section class="wa-chat-panel" id="waChatPanel">
            <div class="wa-chat-placeholder" id="waChatPlaceholder">
                <svg viewBox="0 0 303 172" class="wa-placeholder-icon" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M229.565 160.229c32.647-10.984 57.634-40.44 62.535-76.033C298.462 39.6 267.925 0 224.006 0c-6.048 0-11.938.86-17.548 2.462C186.06-9.6 156.94-2.2 143 21.8c-24-8-52 10-52 36 0 3 0 6 1 9-24 4-42 25-42 50 0 28 22.5 51 50.5 51h129.065Z" opacity=".5"/></svg>
                <h2>HRMS Chat</h2>
                <p>Select a mobile number on the left and click <strong>Start Chat</strong> to talk to the assistant.</p>
                <div class="wa-placeholder-lock">
                    <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM9 8V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9z"/></svg>
                    <span>Internal HRMS assistant &mdash; no login required</span>
                </div>
            </div>

            <div class="wa-chat-active" id="waChatActive" hidden>
                <header class="wa-chat-header">
                    <div class="wa-avatar" id="waActiveAvatar">?</div>
                    <div class="wa-chat-header-info">
                        <div class="wa-chat-header-name" id="waActiveName">—</div>
                        <div class="wa-chat-header-status" id="waActiveStatus">online</div>
                    </div>
                    <div class="wa-header-actions">
                        <button class="wa-icon-btn" title="Video call" type="button">
                            <svg viewBox="0 0 24 24"><path d="M17 10.5V7c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1v10c0 .55.45 1 1 1h12c.55 0 1-.45 1-1v-3.5l4 4v-11l-4 4z"/></svg>
                        </button>
                        <button class="wa-icon-btn" title="Voice call" type="button">
                            <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
                        </button>
                        <button class="wa-icon-btn" title="Search in chat" type="button">
                            <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14Z"/></svg>
                        </button>
                        <button class="wa-icon-btn" title="More options" type="button">
                            <svg viewBox="0 0 24 24"><path d="M12 8a2 2 0 1 0-.001-4.001A2 2 0 0 0 12 8Zm0 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 12 10Zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 12 16Z"/></svg>
                        </button>
                    </div>
                </header>

                <main class="wa-messages" id="waMessages"></main>

                <footer class="wa-composer">
                    <div class="wa-composer-pill">
                        <button class="wa-icon-btn wa-composer-icon" title="Attach" type="button">
                            <svg viewBox="0 0 24 24"><path d="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6z"/></svg>
                        </button>
                        <button class="wa-icon-btn wa-composer-icon" title="Emoji" type="button">
                            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8Zm-3.5-9a1.5 1.5 0 1 0-1.5-1.5A1.5 1.5 0 0 0 8.5 11Zm7 0a1.5 1.5 0 1 0-1.5-1.5A1.5 1.5 0 0 0 15.5 11Zm-3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5Z"/></svg>
                        </button>
                        <textarea id="waInput" class="wa-composer-input" placeholder="Type a message" rows="1"></textarea>
                        <button id="waSendBtn" class="wa-send-btn" type="button" title="Send">
                            <svg viewBox="0 0 24 24"><path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2Z"/></svg>
                        </button>
                    </div>
                </footer>
            </div>
        </section>
    </div>

    <script src="~/js/chat.js"></script>
</body>
</html>
