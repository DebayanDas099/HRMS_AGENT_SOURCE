@{
    ViewData["Title"] = "HRMS Chat";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="~/chat-favicon.svg" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />
</head>
<body class="wa-body">
    <div class="wa-app" id="waApp">
        <!-- Sidebar -->
        <aside class="wa-sidebar" id="waSidebar">
            <div class="wa-sidebar-top">
                <div class="wa-sidebar-header">
                    <div class="wa-avatar wa-brand-avatar">H</div>
                    <h1 class="wa-wordmark">HRMS Chat</h1>
                    <button id="waRefreshBtn" class="wa-icon-btn" title="Reload mobile numbers" type="button">
                        <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                    </button>
                </div>

                <div class="wa-mobile-row">
                    <select id="waMobileSelect" class="wa-select" disabled>
                        <option value="">Loading mobile numbers…</option>
                    </select>
                    <button id="waStartChatBtn" class="wa-start-btn" type="button" hidden>Start Chat</button>
                </div>

                <div class="wa-search">
                    <svg viewBox="0 0 24 24" class="wa-search-icon"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14Z"/></svg>
                    <input type="text" id="waSearchInput" placeholder="Search or start a new chat" />
                </div>
            </div>

            <div class="wa-list" id="waList">
                <div class="wa-empty-state" id="waSidebarEmpty">
                    <p>Select a mobile number above and click <strong>Start Chat</strong> to begin.</p>
                </div>
            </div>
        </aside>

        <!-- Chat panel -->
        <section class="wa-chat-panel" id="waChatPanel">
            <div class="wa-chat-placeholder" id="waChatPlaceholder">
                <svg viewBox="0 0 303 172" class="wa-placeholder-icon" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M229.565 160.229c32.647-10.984 57.634-40.44 62.535-76.033C298.462 39.6 267.925 0 224.006 0c-6.048 0-11.938.86-17.548 2.462C186.06-9.6 156.94-2.2 143 21.8c-24-8-52 10-52 36 0 3 0 6 1 9-24 4-42 25-42 50 0 28 22.5 51 50.5 51h129.065Z" opacity=".5"/></svg>
                <h2>HRMS Chat</h2>
                <p>Select a mobile number on the left and click <strong>Start Chat</strong> to talk to the assistant.</p>
                <div class="wa-placeholder-lock">
                    <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zM9 8V6c0-1.66 1.34-3 3-3s3 1.34 3 3v2H9z"/></svg>
                    <span>Internal HRMS assistant &mdash; no login required</span>
                </div>
            </div>

            <div class="wa-chat-active" id="waChatActive" hidden>
                <header class="wa-chat-header">
                    <div class="wa-avatar" id="waActiveAvatar">?</div>
                    <div class="wa-chat-header-info">
                        <div class="wa-chat-header-name" id="waActiveName">—</div>
                        <div class="wa-chat-header-status" id="waActiveStatus">online</div>
                    </div>
                    <div class="wa-header-actions">
                        <button class="wa-icon-btn" title="Search in chat" type="button">
                            <svg viewBox="0 0 24 24"><path d="M15.5 14h-.79l-.28-.27a6.5 6.5 0 1 0-.7.7l.27.28v.79l5 4.99L20.49 19l-4.99-5Zm-6 0A4.5 4.5 0 1 1 14 9.5 4.5 4.5 0 0 1 9.5 14Z"/></svg>
                        </button>
                        <button class="wa-icon-btn" title="More options" type="button">
                            <svg viewBox="0 0 24 24"><path d="M12 8a2 2 0 1 0-.001-4.001A2 2 0 0 0 12 8Zm0 2a2 2 0 1 0 .001 4.001A2 2 0 0 0 12 10Zm0 6a2 2 0 1 0 .001 4.001A2 2 0 0 0 12 16Z"/></svg>
                        </button>
                    </div>
                </header>

                <main class="wa-messages" id="waMessages"></main>

                <footer class="wa-composer">
                    <div class="wa-composer-pill">
                        <button class="wa-icon-btn wa-composer-icon" title="Emoji" type="button">
                            <svg viewBox="0 0 24 24"><path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm0 18a8 8 0 1 1 8-8 8 8 0 0 1-8 8Zm-3.5-9a1.5 1.5 0 1 0-1.5-1.5A1.5 1.5 0 0 0 8.5 11Zm7 0a1.5 1.5 0 1 0-1.5-1.5A1.5 1.5 0 0 0 15.5 11Zm-3.5 6.5c2.33 0 4.31-1.46 5.11-3.5H6.89c.8 2.04 2.78 3.5 5.11 3.5Z"/></svg>
                        </button>
                        <button id="waMicBtn" class="wa-icon-btn wa-composer-icon wa-mic-btn" type="button" title="Tap to record voice message">
                            <svg viewBox="0 0 24 24"><path d="M12 14a3 3 0 0 0 3-3V5a3 3 0 1 0-6 0v6a3 3 0 0 0 3 3Zm5-3a5 5 0 0 1-10 0H5a7 7 0 0 0 6 6.92V21h2v-3.08A7 7 0 0 0 19 11h-2Z"/></svg>
                        </button>
                        <textarea id="waInput" class="wa-composer-input" placeholder="Type a message" rows="1"></textarea>
                        <button id="waSendBtn" class="wa-send-btn" type="button" title="Send" disabled>
                            <svg class="wa-ic-send" viewBox="0 0 24 24"><path d="M2.01 21 23 12 2.01 3 2 10l15 2-15 2Z"/></svg>
                        </button>
                    </div>
                </footer>
            </div>
        </section>
    </div>

    <script src="~/js/chat.js" asp-append-version="true"></script>
</body>
</html>
