@{
    ViewData["Title"] = "Document Repository";
    Layout = "_AdminLayout";
}

<div class="doc-repo-page">
    <div class="page-hero animate-up">
        <div class="page-hero-content">
            <p class="dashboard-greeting" id="docRepoStatus">Document repository is ready.</p>
            <h1 class="page-hero-title">Document <span>Corpus</span></h1>
            <p class="page-hero-subtitle">Upload policy documents and training materials to Azure blob storage.</p>
        </div>
        <div class="page-hero-art" aria-hidden="true">
            <div class="hero-cloud hero-cloud-1"></div>
            <div class="hero-cloud hero-cloud-2"></div>
            <div class="hero-folder">
                <iconify-icon icon="ph:folder-open-duotone"></iconify-icon>
            </div>
            <div class="hero-upload-arrow">
                <iconify-icon icon="ph:arrow-up-duotone"></iconify-icon>
            </div>
        </div>
    </div>

    <div class="stats-grid doc-stats-grid animate-up delay-1" id="docStatsGrid">
        <div class="stat-card">
            <div class="stat-card-body">
                <div class="stat-icon purple">
                    <iconify-icon icon="ph:files-duotone"></iconify-icon>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Total Documents</span>
                    <span class="stat-value" id="statTotalDocuments">0</span>
                </div>
            </div>
            <svg class="stat-wave purple" viewBox="0 0 300 54" preserveAspectRatio="none"><path d="M0 30 C45 10 95 50 150 28 S255 8 300 32 V54 H0 Z" fill="currentColor"/></svg>
        </div>
        <div class="stat-card">
            <div class="stat-card-body">
                <div class="stat-icon blue">
                    <iconify-icon icon="ph:file-text-duotone"></iconify-icon>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Policy Documents</span>
                    <span class="stat-value" id="statPolicyDocuments">0</span>
                </div>
            </div>
            <svg class="stat-wave blue" viewBox="0 0 300 54" preserveAspectRatio="none"><path d="M0 26 C60 46 110 12 160 30 S240 48 300 22 V54 H0 Z" fill="currentColor"/></svg>
        </div>
        <div class="stat-card">
            <div class="stat-card-body">
                <div class="stat-icon teal">
                    <iconify-icon icon="ph:graduation-cap-duotone"></iconify-icon>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Training Materials</span>
                    <span class="stat-value" id="statTrainingDocuments">0</span>
                </div>
            </div>
            <svg class="stat-wave teal" viewBox="0 0 300 54" preserveAspectRatio="none"><path d="M0 34 C55 14 105 44 155 26 S250 10 300 36 V54 H0 Z" fill="currentColor"/></svg>
        </div>
        <div class="stat-card">
            <div class="stat-card-body">
                <div class="stat-icon pink">
                    <iconify-icon icon="ph:check-circle-duotone"></iconify-icon>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Active Documents</span>
                    <span class="stat-value" id="statActiveDocuments">0</span>
                </div>
            </div>
            <svg class="stat-wave pink" viewBox="0 0 300 54" preserveAspectRatio="none"><path d="M0 28 C50 48 100 16 150 34 S230 12 300 30 V54 H0 Z" fill="currentColor"/></svg>
        </div>
        <div class="stat-card">
            <div class="stat-card-body">
                <div class="stat-icon red">
                    <iconify-icon icon="ph:archive-duotone"></iconify-icon>
                </div>
                <div class="stat-info">
                    <span class="stat-label">Inactive Documents</span>
                    <span class="stat-value" id="statInactiveDocuments">0</span>
                </div>
            </div>
            <svg class="stat-wave red" viewBox="0 0 300 54" preserveAspectRatio="none"><path d="M0 32 C48 12 98 42 148 24 S252 8 300 28 V54 H0 Z" fill="currentColor"/></svg>
        </div>
    </div>

    <div class="doc-toolbar panel-card animate-up delay-2">
        <div class="doc-toolbar-left">
            <div class="doc-type-tabs" role="tablist" aria-label="Document type">
                <button class="doc-type-tab active" type="button" role="tab" aria-selected="true" data-category="Policy" id="tabPolicy">
                    <iconify-icon icon="ph:file-text-duotone"></iconify-icon>
                    <span>Policy Documents</span>
                </button>
                <button class="doc-type-tab" type="button" role="tab" aria-selected="false" data-category="Training" id="tabTraining">
                    <iconify-icon icon="ph:graduation-cap-duotone"></iconify-icon>
                    <span>Training Materials</span>
                </button>
            </div>
        </div>
        <div class="doc-toolbar-right">
            <input type="file" id="bulkFileInput" multiple accept="@DocumentUploadConstants.AcceptAttribute" hidden />
            <button class="btn-ingestion btn-sm" type="button" id="startIngestionBtn" disabled>
                <iconify-icon icon="ph:database-duotone"></iconify-icon>
                <span>Start Ingestion</span>
            </button>
            <button class="btn-gradient btn-sm" type="button" id="bulkUploadBtn">
                <iconify-icon icon="ph:upload-simple-duotone"></iconify-icon>
                <span>Bulk Upload</span>
            </button>
        </div>
    </div>

    <div class="upload-progress panel-card animate-up delay-2" id="ingestionProgressPanel" hidden>
        <div class="upload-progress-header">
            <strong id="ingestionProgressTitle">Ingesting documents...</strong>
            <span id="ingestionProgressCount">0 / 0</span>
        </div>
        <div class="upload-progress-bar">
            <div class="upload-progress-fill ingestion" id="ingestionProgressFill"></div>
        </div>
        <p class="upload-progress-message" id="ingestionProgressMessage"></p>
    </div>

    <div class="upload-progress panel-card animate-up delay-2" id="uploadProgressPanel" hidden>
        <div class="upload-progress-header">
            <strong id="uploadProgressTitle">Uploading documents...</strong>
            <span id="uploadProgressCount">0 / 0</span>
        </div>
        <div class="upload-progress-bar">
            <div class="upload-progress-fill" id="uploadProgressFill"></div>
        </div>
        <p class="upload-progress-message" id="uploadProgressMessage"></p>
    </div>

    <div class="panel-card animate-up delay-3 page-panel doc-table-panel" id="docTablePanel">
        <div class="panel-header doc-table-header">
            <div>
                <h3 id="docTableTitle">Document Corpus</h3>
                <p id="docTableSubtitle">Uploaded policy files stored in Azure blob storage</p>
            </div>
            <div class="doc-table-actions">
                <div class="doc-search-box">
                    <iconify-icon icon="ph:magnifying-glass-duotone"></iconify-icon>
                    <input type="search" id="documentSearch" placeholder="Search documents..." />
                </div>
                <span class="doc-count-badge" id="documentCountBadge">0</span>
                <button class="btn-icon" type="button" id="refreshDocumentsBtn" title="Refresh">
                    <iconify-icon icon="ph:arrows-clockwise-duotone"></iconify-icon>
                </button>
            </div>
        </div>

        <div class="doc-table-wrap">
            <table class="doc-table" id="documentsTable">
                <colgroup>
                    <col class="doc-col-ingest-select" />
                    <col class="doc-col-title" />
                    <col class="doc-col-category" />
                    <col class="doc-col-ingestion" />
                    <col class="doc-col-created-by" />
                    <col class="doc-col-date" />
                    <col class="doc-col-actions" />
                </colgroup>
                <thead>
                    <tr>
                        <th class="doc-ingest-col">Ingest</th>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Ingestion</th>
                        <th>Created By</th>
                        <th>Created Date</th>
                        <th class="doc-actions-col">Actions</th>
                    </tr>
                </thead>
                <tbody id="documentsTableBody">
                    <tr class="doc-empty-row">
                        <td colspan="7">
                            <div class="empty-state compact">
                                <div class="empty-state-icon">
                                    <iconify-icon icon="ph:folder-open-duotone"></iconify-icon>
                                </div>
                                <h4>No documents yet</h4>
                                <p>Use bulk upload to add policy or training documents.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="doc-pagination" id="docPagination" hidden>
            <div class="doc-pagination-info" id="paginationInfo">Showing 0 of 0</div>
            <div class="doc-pagination-controls">
                <button class="btn-outline btn-sm doc-page-nav" type="button" id="prevPageBtn" disabled>
                    <iconify-icon icon="ph:caret-left-duotone"></iconify-icon>
                </button>
                <div class="doc-pagination-pages" id="paginationPages"></div>
                <button class="btn-outline btn-sm doc-page-nav" type="button" id="nextPageBtn" disabled>
                    <iconify-icon icon="ph:caret-right-duotone"></iconify-icon>
                </button>
                <span class="doc-page-size">10 / page</span>
            </div>
        </div>
    </div>
</div>

<div class="doc-upload-modal" id="uploadModal" hidden aria-hidden="true">
    <div class="doc-upload-modal-backdrop" id="uploadModalBackdrop"></div>
    <div class="doc-upload-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="uploadModalTitle">
        <div class="doc-upload-modal-header">
            <div>
                <h3 id="uploadModalTitle">Prepare Upload</h3>
                <p id="uploadModalSubtitle">Add a title for each document before uploading.</p>
            </div>
            <button class="btn-icon doc-upload-modal-close" type="button" id="closeUploadModal" title="Close">
                <iconify-icon icon="ph:x-duotone"></iconify-icon>
            </button>
        </div>
        <div class="doc-upload-modal-body" id="uploadModalList"></div>
        <div class="doc-upload-modal-footer">
            <button class="btn-outline" type="button" id="cancelUploadModal">Cancel</button>
            <button class="btn-gradient btn-sm" type="button" id="confirmUploadModal">
                <iconify-icon icon="ph:cloud-arrow-up-duotone"></iconify-icon>
                <span>Upload Documents</span>
            </button>
        </div>
    </div>
</div>

<div class="doc-confirm-modal" id="deleteConfirmModal" hidden aria-hidden="true">
    <div class="doc-confirm-modal-backdrop" id="deleteConfirmBackdrop"></div>
    <div class="doc-confirm-modal-dialog" role="alertdialog" aria-modal="true" aria-labelledby="deleteConfirmTitle" aria-describedby="deleteConfirmMessage">
        <div class="doc-confirm-icon" aria-hidden="true">
            <iconify-icon icon="ph:trash-duotone"></iconify-icon>
        </div>
        <h3 id="deleteConfirmTitle">Delete Document?</h3>
        <p class="doc-confirm-message" id="deleteConfirmMessage">Are you sure you want to delete this document?</p>
        <span class="doc-confirm-doc-name" id="deleteConfirmDocName"></span>
        <div class="doc-confirm-modal-footer">
            <button class="btn-outline" type="button" id="cancelDeleteBtn">Cancel</button>
            <button class="btn-danger" type="button" id="confirmDeleteBtn">
                <iconify-icon icon="ph:trash-duotone"></iconify-icon>
                <span id="confirmDeleteBtnLabel">Yes, Delete</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="~/css/document-repository.css" asp-append-version="true" />
    <script src="~/js/document-repository.js" asp-append-version="true"></script>
}
