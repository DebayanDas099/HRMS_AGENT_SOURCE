@{
    ViewData["Title"] = "Conversations";
    Layout = "_AdminLayout";
}

<div class="page-hero animate-up">
    <div class="page-hero-content">
        <p class="dashboard-greeting">Chat history</p>
        <h1 class="page-hero-title"><span>Conversations</span></h1>
        <p class="page-hero-subtitle">Review employee chatbot sessions, queries, and responses.</p>
    </div>
    <div class="page-hero-art" aria-hidden="true">
        <div class="hero-cloud hero-cloud-1"></div>
        <div class="hero-folder">
            <iconify-icon icon="ph:chats-circle-duotone"></iconify-icon>
        </div>
    </div>
</div>

<div class="stats-grid animate-up delay-1">
    <div class="stat-card">
        <div class="stat-card-body">
            <div class="stat-icon purple">
                <iconify-icon icon="ph:chat-circle-dots-duotone"></iconify-icon>
            </div>
            <div class="stat-info">
                <span class="stat-label">Total Sessions</span>
                <span class="stat-value">0</span>
                <span class="stat-change positive">All time</span>
            </div>
        </div>
        <svg class="stat-wave purple" viewBox="0 0 300 54" preserveAspectRatio="none"><path d="M0 30 C45 10 95 50 150 28 S255 8 300 32 V54 H0 Z" fill="currentColor"/></svg>
    </div>
    <div class="stat-card">
        <div class="stat-card-body">
            <div class="stat-icon blue">
                <iconify-icon icon="ph:calendar-duotone"></iconify-icon>
            </div>
            <div class="stat-info">
                <span class="stat-label">Today</span>
                <span class="stat-value">0</span>
                <span class="stat-change positive">New sessions</span>
            </div>
        </div>
        <svg class="stat-wave blue" viewBox="0 0 300 54" preserveAspectRatio="none"><path d="M0 26 C60 46 110 12 160 30 S240 48 300 22 V54 H0 Z" fill="currentColor"/></svg>
    </div>
    <div class="stat-card">
        <div class="stat-card-body">
            <div class="stat-icon teal">
                <iconify-icon icon="ph:check-circle-duotone"></iconify-icon>
            </div>
            <div class="stat-info">
                <span class="stat-label">Resolved</span>
                <span class="stat-value">0</span>
                <span class="stat-change positive">Completed chats</span>
            </div>
        </div>
        <svg class="stat-wave teal" viewBox="0 0 300 54" preserveAspectRatio="none"><path d="M0 34 C55 14 105 44 155 26 S250 10 300 36 V54 H0 Z" fill="currentColor"/></svg>
    </div>
    <div class="stat-card">
        <div class="stat-card-body">
            <div class="stat-icon pink">
                <iconify-icon icon="ph:timer-duotone"></iconify-icon>
            </div>
            <div class="stat-info">
                <span class="stat-label">Avg Duration</span>
                <span class="stat-value">—</span>
                <span class="stat-change positive">Per session</span>
            </div>
        </div>
        <svg class="stat-wave pink" viewBox="0 0 300 54" preserveAspectRatio="none"><path d="M0 28 C50 48 100 16 150 34 S230 12 300 30 V54 H0 Z" fill="currentColor"/></svg>
    </div>
</div>

<div class="panel-card animate-up delay-2 page-panel">
    <div class="panel-header">
        <div>
            <h3>Recent Conversations</h3>
            <p>Latest employee interactions with the HRMS chatbot</p>
        </div>
        <button class="btn-icon" type="button" title="Refresh">
            <iconify-icon icon="ph:arrows-clockwise-duotone"></iconify-icon>
        </button>
    </div>

    <div class="empty-state">
        <div class="empty-state-icon">
            <iconify-icon icon="ph:chats-circle-duotone"></iconify-icon>
        </div>
        <h4>No conversations yet</h4>
        <p>Employee chat sessions will appear here once users start interacting with the chatbot.</p>
    </div>
</div>
